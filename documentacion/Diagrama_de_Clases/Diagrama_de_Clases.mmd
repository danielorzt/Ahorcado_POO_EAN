JPanel <|-- PanelPistas
JPanel <|-- PanelEstado
JFrame <|-- VentanaPrincipal
FocusTraversalPolicy <|-- OrdenTabulacion
VistaJuego <|.. VentanaPrincipal
VistaJuego <|.. VistaFalsa

%% Asociaciones con multiplicidad
BancoPalabras "1" *-- "8" Categoria : categorias
Categoria "1" *-- "25" Palabra : palabras
BancoPalabras "1" o-- "0..200" Palabra : usadas
Palabra "*" --> "1" Dificultad : dificultad
Partida "1" *-- "3" Pista : pistas
Partida "1" --> "1" Palabra : palabraSecreta
Partida "1" --> "1" EstadoJuego : estado
ControladorJuego "1" --> "1" BancoPalabras : banco
ControladorJuego "1" --> "0..1" Partida : partida
ControladorJuego "1" --> "0..1" VistaJuego : vista
VentanaPrincipal "1" --> "1" ControladorJuego : controlador
VentanaPrincipal "1" *-- "1" PanelAhorcado
VentanaPrincipal "1" *-- "1" PanelEstado
VentanaPrincipal "1" *-- "1" PanelPistas
VentanaPrincipal "1" *-- "1" PanelTeclado
VentanaPrincipal "1" *-- "1" OrdenTabulacion : clase anidada
PanelAhorcado "1" *-- "7" ParteCuerpo : partes
PruebasAutomaticas "1" *-- "1" VistaFalsa : clase anidada

