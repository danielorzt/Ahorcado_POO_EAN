@startuml Diagrama_de_Clases
' =====================================================================
' Juego del Ahorcado - Universidad EAN - Programacion Orientada a Objetos
' Diagrama de clases COMPLETO (paquetes: modelo, controlador, vista, util
' + Main en el paquete por defecto). Refleja el codigo de codigo_fuente/src.
' Notacion: + public, - private, # protected, {static}, {abstract},
'           {readOnly} = atributo final (no se reasigna).
' =====================================================================
title Juego del Ahorcado - Diagrama de clases completo

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam ArrowColor #2C3E70
skinparam BackgroundColor white
skinparam class {
  BackgroundColor #F7F9FF
  BorderColor #2C3E70
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #FCFCFC
  BorderColor #8A94B8
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B8860B
}
hide empty members

' ---------------------------------------------------------------------
' Clases externas (JDK) que aparecen en las relaciones de herencia
' ---------------------------------------------------------------------
package "Java Swing / AWT (JDK)" <<Rectangle>> {
  class JFrame <<javax.swing>>
  class JPanel <<javax.swing>>
  abstract class FocusTraversalPolicy <<java.awt>>
}

' =====================================================================
package modelo {

  enum Dificultad <<enumeration>> {
    FACIL
    MEDIO
    DIFICIL
    -etiqueta : String {readOnly}
    -Dificultad(etiqueta : String)
    +getEtiqueta() : String
    +{static} paraLongitud(longitud : int) : Dificultad
    +toString() : String
  }

  enum EstadoJuego <<enumeration>> {
    EN_CURSO
    GANADA
    PERDIDA
  }

  enum ResultadoLetra <<enumeration>> {
    ACERTADA
    FALLADA
    REPETIDA
    INVALIDA
    PARTIDA_TERMINADA
  }

  class Palabra <<final>> {
    -texto : String {readOnly}
    -textoOriginal : String {readOnly}
    -pista : String {readOnly}
    -categoria : String {readOnly}
    -dificultad : Dificultad {readOnly}
    +Palabra(textoOriginal : String, pista : String, categoria : String)
    +getTexto() : String
    +getTextoOriginal() : String
    +getPista() : String
    +getCategoria() : String
    +getDificultad() : Dificultad
    +longitud() : int
    +contiene(letra : char) : boolean
    +equals(otro : Object) : boolean
    +hashCode() : int
    +toString() : String
  }

  class Categoria {
    -nombre : String
    -palabras : ArrayList<Palabra>
    +Categoria(nombre : String)
    +agregar(p : Palabra) : void
    +getPalabras() : ArrayList<Palabra>
    +obtenerPorDificultad(d : Dificultad) : ArrayList<Palabra>
    +tamano() : int
    +getNombre() : String
  }

  class BancoPalabras {
    -categorias : ArrayList<Categoria>
    -usadas : ArrayList<Palabra>
    -azar : Random
    +BancoPalabras()
    -buscarOCrearCategoria(nombre : String) : Categoria
    +elegirAleatoria(dificultad : Dificultad) : Palabra
    +totalPalabras() : int
    +getCategorias() : ArrayList<Categoria>
    +resumenPorCategoria() : String
    +contarPorDificultad(d : Dificultad) : int
    +contiene(textoNormalizado : String) : boolean
  }

  class DatosPalabras <<final>> <<paquete-privada>> {
    ~{static} DATOS : String[][] {readOnly}
    -DatosPalabras()
  }

  abstract class Pista <<abstract>> {
    -nombre : String {readOnly}
    -descripcion : String {readOnly}
    -usada : boolean
    #Pista(nombre : String, descripcion : String)
    +usar(partida : Partida) : String
    +{abstract} obtener(partida : Partida) : String
    +isUsada() : boolean
    +getNombre() : String
    +getDescripcion() : String
  }

  class PistaCategoria {
    +PistaCategoria()
    +obtener(p : Partida) : String
  }

  class PistaLetra {
    -azar : Random {readOnly}
    +PistaLetra()
    +obtener(p : Partida) : String
  }

  class PistaTexto {
    +PistaTexto()
    +obtener(p : Partida) : String
  }

  class Partida {
    +{static} MAX_ERRORES : int = 7 {readOnly}
    -palabraSecreta : Palabra
    -letrasCorrectas : ArrayList<Character>
    -letrasIncorrectas : ArrayList<Character>
    -pistas : ArrayList<Pista>
    -pistasObtenidas : ArrayList<String>
    -estado : EstadoJuego
    +Partida(palabra : Palabra)
    +adivinar(letra : char) : ResultadoLetra
    +revelarLetra(letra : char) : void
    +usarPista(indice : int) : String
    +pistaDisponible(indice : int) : boolean
    +pistasRestantes() : int
    +getErrores() : int
    +intentosRestantes() : int
    +palabraOculta() : String
    +estaCompleta() : boolean
    +getPalabra() : Palabra
    +getEstado() : EstadoJuego
    +getLetrasCorrectas() : ArrayList<Character>
    +getLetrasIncorrectas() : ArrayList<Character>
    +getPistasObtenidas() : ArrayList<String>
    -actualizarEstado() : void
  }
}

' =====================================================================
package controlador {

  interface VistaJuego <<interface>> {
    +{abstract} actualizar(partida : Partida) : void
    +{abstract} mostrarFin(partida : Partida) : void
    +{abstract} mostrarMensaje(mensaje : String) : void
  }

  class ControladorJuego {
    -banco : BancoPalabras {readOnly}
    -vista : VistaJuego
    -partida : Partida
    +ControladorJuego(banco : BancoPalabras)
    +setVista(vista : VistaJuego) : void
    +iniciarNuevaPartida(dificultad : Dificultad) : void
    +iniciarPartidaConPalabra(palabra : Palabra) : void
    +procesarLetra(letra : char) : void
    +usarPista(indice : int) : void
    +getPartida() : Partida
    +salir() : void
    -refrescar() : void
    -avisar(mensaje : String) : void
  }
}

' =====================================================================
package vista {

  class Estilo <<final>> {
    +{static} FONDO : Color {readOnly}
    +{static} PRIMARIO : Color {readOnly}
    +{static} ACENTO : Color {readOnly}
    +{static} TEXTO : Color {readOnly}
    +{static} ACIERTO : Color {readOnly}
    +{static} ERROR : Color {readOnly}
    +{static} TARJETA : Color {readOnly}
    +{static} BORDE : Color {readOnly}
    +{static} MADERA : Color {readOnly}
    +{static} CUERDA : Color {readOnly}
    +{static} TITULO : Font {readOnly}
    +{static} SUBTITULO : Font {readOnly}
    +{static} NORMAL : Font {readOnly}
    +{static} BOTON : Font {readOnly}
    +{static} TECLA : Font {readOnly}
    +{static} PALABRA : Font {readOnly}
    -Estilo()
    +{static} configurarLookAndFeel() : void
    +{static} margen(px : int) : Border
    +{static} tarjeta(titulo : String) : Border
    +{static} estilizarBoton(boton : JButton) : void
  }

  abstract class ParteCuerpo <<abstract>> {
    -nombre : String {readOnly}
    -origenX : int {readOnly}
    -origenY : int {readOnly}
    -escala : double {readOnly}
    #ParteCuerpo(nombre : String, origenX : int, origenY : int, escala : double)
    +{abstract} dibujar(g : Graphics2D) : void
    +getNombre() : String
    #px(desplazamiento : double) : int
    #py(desplazamiento : double) : int
    #largo(valor : double) : int
    #grosor(valor : double) : float
  }

  class Cabeza {
    +Cabeza(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class Torso {
    +Torso(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class BrazoDerecho {
    +BrazoDerecho(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class BrazoIzquierdo {
    +BrazoIzquierdo(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class PiernaDerecha {
    +PiernaDerecha(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class PiernaIzquierda {
    +PiernaIzquierda(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }
  class Cuerda {
    +Cuerda(origenX : int, origenY : int, escala : double)
    +dibujar(g : Graphics2D) : void
  }

  class PanelAhorcado {
    -{static} serialVersionUID : long {readOnly}
    -{static} LIENZO_ANCHO : int = 300 {readOnly}
    -{static} LIENZO_ALTO : int = 400 {readOnly}
    -{static} ORIGEN_X : int = 210 {readOnly}
    -{static} ORIGEN_Y : int = 120 {readOnly}
    -partes : ArrayList<ParteCuerpo> {readOnly}
    -errores : int
    +PanelAhorcado()
    +setErrores(n : int) : void
    +getErrores() : int
    +getNombresPartes() : ArrayList<String>
    #paintComponent(g : Graphics) : void
    -dibujarHorca(g : Graphics2D) : void
  }

  class PanelTeclado {
    -{static} serialVersionUID : long {readOnly}
    +{static} LETRAS : String {readOnly}
    -botones : ArrayList<JButton> {readOnly}
    -escuchaLetra : Consumer<Character>
    +PanelTeclado()
    +setEscuchaLetra(escucha : Consumer<Character>) : void
    +setEnabledLetras(usadas : ArrayList<Character>, activo : boolean) : void
    +getBotones() : ArrayList<JButton>
  }

  class PanelPistas {
    -{static} serialVersionUID : long {readOnly}
    -botones : JButton[3] {readOnly}
    -etiquetaRestantes : JLabel {readOnly}
    -areaPistas : JTextArea {readOnly}
    -escuchaPista : Consumer<Integer>
    +PanelPistas()
    +setEscuchaPista(escucha : Consumer<Integer>) : void
    +setPistaUsada(i : int) : void
    +setPistaDisponible(i : int, disponible : boolean) : void
    +setPistasRestantes(n : int) : void
    +setTextoPistas(textos : ArrayList<String>) : void
    +getBotones() : ArrayList<JButton>
  }

  class PanelEstado {
    -{static} serialVersionUID : long {readOnly}
    -etiquetaPalabra : JLabel {readOnly}
    -etiquetaDificultad : JLabel {readOnly}
    -etiquetaCorrectas : JLabel {readOnly}
    -etiquetaIncorrectas : JLabel {readOnly}
    -etiquetaIntentos : JLabel {readOnly}
    +PanelEstado()
    +actualizar(p : Partida) : void
    -unir(letras : ArrayList<Character>) : String
  }

  class VentanaPrincipal {
    -{static} serialVersionUID : long {readOnly}
    -controlador : ControladorJuego {readOnly}
    -panelAhorcado : PanelAhorcado {readOnly}
    -panelEstado : PanelEstado {readOnly}
    -panelPistas : PanelPistas {readOnly}
    -panelTeclado : PanelTeclado {readOnly}
    -etiquetaMensaje : JLabel {readOnly}
    -comboDificultad : JComboBox<String> {readOnly}
    -botonNueva : JButton {readOnly}
    -botonAyuda : JButton {readOnly}
    +VentanaPrincipal(controlador : ControladorJuego)
    -crearMenu() : JMenuBar
    -crearBarraSuperior() : JPanel
    -crearCentro() : JPanel
    -crearBarraMensaje() : JPanel
    -conectarEventos() : void
    -configurarAccesibilidad() : void
    -configurarTabulacion() : void
    -instalarTecladoFisico() : void
    -nuevaPartida() : void
    -dificultadSeleccionada() : Dificultad
    -mostrarAyuda() : void
    +actualizar(partida : Partida) : void
    +mostrarFin(partida : Partida) : void
    +mostrarMensaje(mensaje : String) : void
    +crearDialogoFin(partida : Partida) : JDialog
  }

  class "VentanaPrincipal.OrdenTabulacion" as OrdenTabulacion <<private static>> {
    -orden : ArrayList<Component> {readOnly}
    ~OrdenTabulacion(orden : ArrayList<Component>)
    -buscar(actual : Component, paso : int) : Component
    +getComponentAfter(raiz : Container, actual : Component) : Component
    +getComponentBefore(raiz : Container, actual : Component) : Component
    +getFirstComponent(raiz : Container) : Component
    +getLastComponent(raiz : Container) : Component
    +getDefaultComponent(raiz : Container) : Component
  }
}

' =====================================================================
package util {

  class Normalizador <<final>> {
    -Normalizador()
    +{static} normalizar(s : String) : String
    +{static} normalizarLetra(c : char) : char
    +{static} esLetraValida(c : char) : boolean
  }

  class VerificadorBanco <<final>> {
    -{static} TOTAL_ESPERADO : int = 200 {readOnly}
    -{static} CATEGORIAS_ESPERADAS : int = 8 {readOnly}
    -{static} POR_CATEGORIA : int = 25 {readOnly}
    -VerificadorBanco()
    +{static} main(args : String[]) : void
  }

  class PruebasAutomaticas <<final>> {
    -{static} total : int
    -{static} fallos : int
    -PruebasAutomaticas()
    +{static} main(args : String[]) : void
    -{static} comprobar(nombre : String, condicion : boolean) : void
    -{static} palabraPrueba(texto : String) : Palabra
    -{static} pruebasNormalizador() : void
    -{static} pruebasPalabra() : void
    -{static} pruebasBanco() : void
    -{static} pruebasPartida() : void
    -{static} pruebasPistas() : void
    -{static} pruebasControlador() : void
    -{static} pruebasDibujo() : void
  }

  class "PruebasAutomaticas.VistaFalsa" as VistaFalsa <<private static>> {
    ~actualizaciones : int
    ~finales : int
    ~ultimoMensaje : String
    +actualizar(partida : Partida) : void
    +mostrarFin(partida : Partida) : void
    +mostrarMensaje(mensaje : String) : void
  }

  class GeneradorCapturas <<final>> {
    -{static} PALABRA : Palabra {readOnly}
    -GeneradorCapturas()
    +{static} main(args : String[]) : void
    -{static} generar(carpeta : Path) : void
    -{static} guardar(contenedor : Object, archivo : Path) : void
  }
}

' =====================================================================
' Paquete por defecto
class Main {
  +{static} main(args : String[]) : void
}

' =====================================================================
' HERENCIA / REALIZACION DE INTERFACES
' =====================================================================
Pista <|-- PistaCategoria
Pista <|-- PistaLetra
Pista <|-- PistaTexto

ParteCuerpo <|-- Cabeza
ParteCuerpo <|-- Torso
ParteCuerpo <|-- BrazoDerecho
ParteCuerpo <|-- BrazoIzquierdo
ParteCuerpo <|-- PiernaDerecha
ParteCuerpo <|-- PiernaIzquierda
ParteCuerpo <|-- Cuerda

JPanel <|-- PanelAhorcado
JPanel <|-- PanelTeclado
JPanel <|-- PanelPistas
JPanel <|-- PanelEstado
JFrame <|-- VentanaPrincipal
FocusTraversalPolicy <|-- OrdenTabulacion

VistaJuego <|.. VentanaPrincipal
VistaJuego <|.. VistaFalsa

' =====================================================================
' ASOCIACIONES, COMPOSICIONES Y AGREGACIONES (con multiplicidades)
' =====================================================================
BancoPalabras "1" *-- "8" Categoria : categorias
Categoria "1" *-- "25" Palabra : palabras
BancoPalabras "1" o-- "0..200" Palabra : usadas
Palabra "*" --> "1" Dificultad : dificultad

Partida "1" *-- "3" Pista : pistas
Partida "1" --> "1" Palabra : palabraSecreta
Partida "1" --> "1" EstadoJuego : estado

ControladorJuego "1" --> "1" BancoPalabras : banco
ControladorJuego "1" --> "0..1" Partida : partida
ControladorJuego "1" --> "0..1" VistaJuego : vista

VentanaPrincipal "1" --> "1" ControladorJuego : controlador
VentanaPrincipal "1" *-- "1" PanelAhorcado
VentanaPrincipal "1" *-- "1" PanelEstado
VentanaPrincipal "1" *-- "1" PanelPistas
VentanaPrincipal "1" *-- "1" PanelTeclado
VentanaPrincipal +-- OrdenTabulacion
PanelAhorcado "1" *-- "7" ParteCuerpo : partes
PruebasAutomaticas +-- VistaFalsa

' =====================================================================
' DEPENDENCIAS (uso: parametros, variables locales, llamadas estaticas)
' =====================================================================
BancoPalabras ..> DatosPalabras : lee DATOS
BancoPalabras ..> Dificultad
Palabra ..> Normalizador
Partida ..> ResultadoLetra : devuelve
Partida ..> Normalizador
Pista ..> Partida : usar(partida)

ControladorJuego ..> Dificultad
ControladorJuego ..> Palabra
ControladorJuego ..> ResultadoLetra
ControladorJuego ..> EstadoJuego
ControladorJuego ..> Normalizador

VentanaPrincipal ..> Partida
VentanaPrincipal ..> Dificultad
VentanaPrincipal ..> EstadoJuego
VentanaPrincipal ..> Normalizador
VentanaPrincipal ..> Estilo
PanelEstado ..> Partida
PanelEstado ..> Estilo
PanelPistas ..> Estilo
PanelTeclado ..> Estilo
PanelAhorcado ..> Estilo
Cabeza ..> Estilo
Torso ..> Estilo
BrazoDerecho ..> Estilo
BrazoIzquierdo ..> Estilo
PiernaDerecha ..> Estilo
PiernaIzquierda ..> Estilo
Cuerda ..> Estilo

VerificadorBanco ..> BancoPalabras
VerificadorBanco ..> Categoria
VerificadorBanco ..> Dificultad
PruebasAutomaticas ..> BancoPalabras
PruebasAutomaticas ..> Partida
PruebasAutomaticas ..> Palabra
PruebasAutomaticas ..> Pista
PruebasAutomaticas ..> PistaCategoria
PruebasAutomaticas ..> PistaLetra
PruebasAutomaticas ..> PistaTexto
PruebasAutomaticas ..> ControladorJuego
PruebasAutomaticas ..> PanelAhorcado
PruebasAutomaticas ..> Normalizador
GeneradorCapturas ..> ControladorJuego
GeneradorCapturas ..> VentanaPrincipal
GeneradorCapturas ..> BancoPalabras
GeneradorCapturas ..> Palabra
GeneradorCapturas ..> VistaJuego : clase anonima
GeneradorCapturas ..> Estilo

Main ..> BancoPalabras
Main ..> ControladorJuego
Main ..> VentanaPrincipal
Main ..> VerificadorBanco
Main ..> Estilo

' =====================================================================
' NOTAS
' =====================================================================
note top of BancoPalabras
  Multiplicidades 8 y 25: NO estan fijas en el codigo Java
  (las listas son ArrayList). Salen de los DATOS de
  DatosPalabras.DATOS: 200 palabras = 8 categorias x 25.
  VerificadorBanco y PruebasAutomaticas lo comprueban.
  "usadas" crece de 0 a, como maximo, las palabras candidatas
  (hasta 200) y se vacia al agotarlas.
end note

note right of Partida
  3 = PistaCategoria, PistaLetra, PistaTexto
  (indices 0, 1 y 2). MAX_ERRORES = 7.
  POLIMORFISMO: pistas.get(i).usar(this)
end note

note bottom of PanelAhorcado
  7 = Cabeza, Torso, BrazoDerecho, BrazoIzquierdo,
  PiernaDerecha, PiernaIzquierda, Cuerda (en ese orden).
  POLIMORFISMO: partes.get(i).dibujar(g2)
end note

note bottom of VistaJuego
  El controlador solo conoce esta interfaz (bajo acoplamiento).
  Implementan: VentanaPrincipal, VistaFalsa (pruebas) y una
  clase anonima en GeneradorCapturas.
end note

note bottom of Estilo
  Dependen de Estilo (colores/fuentes) todos los paneles,
  VentanaPrincipal y las 7 partes del cuerpo.
end note

legend right
  <b>Leyenda</b>
  + publico   - privado   # protegido   ~ paquete
  {static} estatico   {abstract} abstracto
  {readOnly} atributo final (no se reasigna)
  <<final>> clase final (no se puede heredar)
  --|>  herencia      ..|>  implementa interfaz
  *--   composicion   o--   agregacion
  -->   asociacion    ..>   dependencia
end legend
@enduml
